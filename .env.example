# PUBG UC / Spark plugin configuration (task spec, section 14).
# Copy to .env and fill in. NEVER commit real secrets.
#
# Flow: buyer pays (bot stays silent) -> buyer sends PUBG UID -> bot validates
# the UID and redeems UC from Spark stock -> reports the result.

# --- FunPay lot(s) ---
# Single-lot quick config (the 60 UC offer):
FUNPAY_LOT_ID=37330959
PRODUCT_NAME=60 UC
UC=60
# PICKS = the Spark stock combination for ONE unit (base packs 60/325/660/1800/
# 3850/8100). For 60 UC it's just {"60":1}. On an order of N units each count is
# multiplied by N.
PICKS={"60": 1}
#
# The lot is matched by the order DESCRIPTION (FunPay gives no offer id):
# by default the advertised UC as a whole number + "uc".
#
# MULTI-LOT (overrides the single-lot vars). A FunPay lot may be a COMBINATION of
# base packs. Easiest: copy lots.example.json -> lots.json, fill real offer ids,
# and point to it:
# LOTS_FILE=plugins/pubg_uc_spark/lots.json
# ...or inline it here. Put your real FunPay offer ids as keys. Ready mapping for
# the denominations you listed:
# LOTS={
#   "37330959": {"product": "60 UC",   "uc": "60",   "picks": {"60": 1}},
#   "ID_120":   {"product": "120 UC",  "uc": "120",  "picks": {"60": 2}},
#   "ID_180":   {"product": "180 UC",  "uc": "180",  "picks": {"60": 3}},
#   "ID_300":   {"product": "300 UC",  "uc": "300",  "picks": {"325": 1}},
#   "ID_325":   {"product": "325 UC",  "uc": "325",  "picks": {"325": 1}},
#   "ID_360":   {"product": "360 UC",  "uc": "360",  "picks": {"325": 1, "60": 1}},
#   "ID_445":   {"product": "445 UC",  "uc": "445",  "picks": {"325": 1, "60": 2}},
#   "ID_600":   {"product": "600 UC",  "uc": "600",  "picks": {"660": 1}},
#   "ID_660":   {"product": "660 UC",  "uc": "660",  "picks": {"660": 1}},
#   "ID_720":   {"product": "720 UC",  "uc": "720",  "picks": {"660": 1, "60": 1}},
#   "ID_1045":  {"product": "1045 UC", "uc": "1045", "picks": {"660": 1, "325": 1, "60": 1}},
#   "ID_1320":  {"product": "1320 UC", "uc": "1320", "picks": {"660": 2}}
# }

# --- Spark HTTP API (api.pubgredeemerbot.com) ---
# BASE url only; endpoints /v1/jobs/stock-redeem and /v1/jobs/{id} are derived.
# Leave SPARK_API_URL empty to run in MOCK mode (no network).
SPARK_API_URL=https://api.pubgredeemerbot.com
# API key from Telegram @sparkucbot -> API menu. Sent as the X-API-Key header.
SPARK_API_KEY=
SPARK_TIMEOUT=30
# Async job polling: per-poll long-poll hold (<=60) and total wait budget.
SPARK_JOB_WAIT=25
SPARK_MAX_WAIT=120
# Force mock even if a URL is set (useful for staging): 1/true/yes
SPARK_MOCK=1

# --- Throughput ---
# Parallel redeem workers. 1 = serial (default). Raise (e.g. 3-5) to handle
# order bursts faster; mind Spark rate limits / daily quota.
SPARK_WORKERS=1

# --- Retry (section 12) ---
MAX_RETRIES=3
RETRY_DELAY=5
RETRY_BACKOFF=2

# --- Startup reconciliation / backfill ---
# FunPayCardinal does NOT replay orders that arrived while it was offline, so an
# order paid during a network outage would otherwise never be delivered. When it
# runs, the plugin pulls the seller's open sales, registers any tracked ones
# missing from the DB, and - if BACKFILL_READ_HISTORY - reads each chat's history
# to pick up a UID the buyer already sent. /uc_backfill always runs it manually.
#
# BACKFILL_MODE controls WHEN the automatic startup scan runs:
#   always   - every startup;
#   watchdog - only when the watchdog created the trigger file (see below), so a
#              manual restart does NOT scan but an unattended watchdog restart does;
#   off      - never on startup (only /uc_backfill).
BACKFILL_MODE=always
# Trigger file for watchdog mode. The watchdog creates it right before starting
# Cardinal; the plugin deletes it on startup. Default: next to this .env.
# BACKFILL_TRIGGER_FILE=/home/root/FunPayCardinal/plugins/pubg_uc_spark/.backfill_request
BACKFILL_READ_HISTORY=1
# Sales pages to scan (each ~100 sales) and chat messages to scan per order.
BACKFILL_MAX_PAGES=3
BACKFILL_HISTORY_LIMIT=50

# --- UID format (section 9) ---
# PUBG player UID = digits only, 9-11 long.
UID_PATTERN=[0-9]{9,11}

# --- Database (section 6) ---
DATABASE_PATH=storage/pubg_uc_spark.db

# --- Admin whitelist (section 18) - Telegram user IDs, comma-separated ---
ADMIN_IDS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=

# --- Buyer message templates.
# Placeholders: {order_id} {product} {uid} {player_name} {quantity} {denomination}
#               {total_uc} {delivered} {total} ---
# MSG_ASK_UID=...            (sent only on admin /uc_resend, never automatically)
# MSG_VALID=...
# MSG_INVALID=...
# MSG_ACCOUNT_NOT_FOUND=...          (1st UID error - ask to retry)
# MSG_ACCOUNT_NOT_FOUND_FINAL=...    (2nd UID error - escalate to seller)
# MSG_BAD_FORMAT=...
# MSG_ERROR=...             (out of stock / final failure)
# MSG_PARTIAL=...           (multi-pack order, only part delivered)
# MSG_TEMPORARY_ERROR=...
# MSG_DUPLICATE=...
