# PUBG UC / Spark plugin configuration (task spec, section 14).
# Copy to .env and fill in. NEVER commit real secrets.

# --- FunPay lot(s) ---
FUNPAY_LOT_ID=37330959
PRODUCT_NAME=PUBG Mobile 60 UC
PRODUCT_QUANTITY=60
# Multi-lot (overrides the single-lot vars above). JSON, lot_id -> meta:
# LOTS={"37330959": {"product": "PUBG 60 UC", "quantity": 60}, "40000000": {"product": "PUBG 120 UC", "quantity": 120}}

# --- Spark HTTP API (api.pubgredeemerbot.com) ---
# BASE url only; endpoints /v1/jobs/check-code and /v1/jobs/{id} are derived.
# Leave SPARK_API_URL empty to run in MOCK mode (no network).
SPARK_API_URL=https://api.pubgredeemerbot.com
# API key from Telegram @sparkucbot -> API menu. Sent as the X-API-Key header.
SPARK_API_KEY=
SPARK_TIMEOUT=30
# Async job polling: per-poll long-poll hold (<=60) and total wait budget.
SPARK_JOB_WAIT=25
SPARK_MAX_WAIT=120
# Force mock even if a URL is set (useful for staging): 1/true/yes
SPARK_MOCK=1

# --- Retry (section 12) ---
MAX_RETRIES=3
RETRY_DELAY=5
RETRY_BACKOFF=2

# --- Code format (section 9) ---
# Spark UC voucher = exactly 18 letters/digits.
CODE_PATTERN=[A-Za-z0-9]{18}

# --- Database (section 6) ---
DATABASE_PATH=storage/pubg_uc_spark.db

# --- Admin whitelist (section 18) - Telegram user IDs, comma-separated ---
ADMIN_IDS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=

# --- Buyer message templates (section 24.11). Placeholders {order_id} {product} ---
# MSG_ASK_CODE=...
# MSG_VALID=...
# MSG_INVALID=...
# MSG_ALREADY_USED=...
# MSG_ACCOUNT_NOT_FOUND=...
# MSG_BAD_FORMAT=...
# MSG_TEMPORARY_ERROR=...
# MSG_DUPLICATE=...
